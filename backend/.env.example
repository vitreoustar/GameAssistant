# ===== DeepSeek (LLM) =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== Steam =====
# Steamworks Web API key（https://steamcommunity.com/dev/apikey 申请）
STEAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 你自己的 steamid64（用于默认演示，也可在页面里输入）
STEAM_ID=7656119xxxxxxxxxx
# 国内直连 Steam 常被拦截，可填本地代理（如 http://127.0.0.1:12450）
STEAM_PROXY=
# 设为 0 可关闭 SSL 证书校验（仅本地调试用，默认 1）
STEAM_VERIFY_SSL=1

# ===== Embedding（本地 sentence-transformers，无需 key）=====
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# 国内下载 HuggingFace 模型/数据集慢时，取消下面一行注释：
# HF_ENDPOINT=https://hf-mirror.com
